te-columns:1fr}\n  }\n</style><div class=\"layout\">\n\n  <aside class=\"side\">\n    <div class=\"mark\">光速 <span>/</span> 说明页</div>\n    <nav aria-label=\"目录\">\n      <ol>\n        <li><a href=\"#how\">怎么开始用</a></li>\n        <li><a href=\"#plans\">套餐对照</a></li>\n        <li><a href=\"#clients\">客户端在哪</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ol>\n    </nav>\n    <p class=\"note\">这页不是营销海报，是把用法、套餐和疑问摊开说的地方。有不明白的地方，先往下翻。</p>\n  </aside>\n\n  <main>\n    <section class=\"hero\">\n      <span class=\"kicker\">说明与套餐 · 一次讲完</span>\n      <h1 class=\"wordmark\">光<em>速</em></h1>\n      <p class=\"lede\">你好，这里是光速的说明页。与其让你在一堆术语里猜，不如把怎么用、选哪档、遇到问题怎么办，像朋友一样直接告诉你。下面三段加一节问答，看完基本就不会再卡住。</p>\n      <div class=\"meta\">\n        <span>三档套餐</span>\n        <span>按年付更省</span>\n        <span>设备数写明</span>\n        <span>问题有人答</span>\n      </div>\n      <div class=\"jump\">\n        <a href=\"#how\">先看怎么开始</a>\n        <a href=\"#plans\">再挑套餐</a>\n        <a href=\"#faq\">卡住了看这里</a>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"how\">\n      <h2>第一次用，按这四步来就行</h2>\n      <p class=\"sub\">不用记顺序，只要别跳步。每一步都不需要什么技术底子，照着做就好。</p>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"no\">01</span>\n          <h3>先想清楚你有几台设备</h3>\n          <p>手机、平板、电脑，各算一台。先数一遍，再去看套餐里的「同时在线设备数」，就知道哪档够用。数错了再换档会很折腾，所以这一步值得花两分钟。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">02</span>\n          <h3>挑一档，别一上来就买最贵的</h3>\n          <p>用得少就选基础版，日常多设备就旗舰版，人多或者办公用再考虑团队版。套餐是按需选的，不是按面子选的。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">03</span>\n          <h3>装好客户端，登录进去</h3>\n          <p>客户端在下面的「客户端在哪」里列清楚了。装完之后用订阅时拿到的账号登录，设备数不要超过你选的那一档。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">04</span>\n          <h3>用一段时间再回头看流量</h3>\n          <p>头一个星期留意一下每月额度够不够。如果经常贴着上限用，下个周期升一档会比临时加购省心。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"plans\">\n      <h2>套餐对照：两栏摆放，一眼看到差别</h2>\n      <p class=\"sub\">基础版和旗舰版是大家最常纠结的两档，摆在一起看差别最直观。团队版放在下面单独说，因为它更像是给一群人用的。</p>\n      <div class=\"compare\">\n        <article class=\"plan\">\n          <h3>基础版</h3>\n          <p class=\"price\">¥15 <small>每月 · 按年付仅需 ¥150/年</small></p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>可解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"foot\">适合自己一个人用，手机加一台电脑，偶尔看看剧。</p>\n        </article>\n        <article class=\"plan recommended\">\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35 <small>每月 · 按年付仅需 ¥350/年</small></p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <p class=\"foot\">设备多、要玩游戏、希望问题被优先处理，这档是最省心的选择。</p>\n        </article>\n      </div>\n      <article class=\"plan\">\n        <h3>团队版</h3>\n        <p class=\"price\">¥85 <small>每月 · 按年付仅需 ¥850/年</small></p>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <p class=\"foot\">几个人一起用，或者办公场景需要统一安排时，再考虑这一档。</p>\n      </article>\n      <p class=\"plans-tip\">小提示：三档的年付价格都是月付的十个月份量，所以如果你确定会用满一年，年付更划算；如果只想先试试水，月付更灵活。</p>\n    </section>\n\n    <section class=\"block\" id=\"clients\">\n      <h2>客户端在哪</h2>\n      <p class=\"sub\">下面的信息只说明各端怎么进入客户端界面。具体下载地址以你订阅后收到的说明为准，这里不提供第三方下载链接，也不代你判断来源。</p>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>手机端</h3>\n          <p>在系统自带的应用商店里搜索客户端名称，认准开发者信息再安装。不熟悉的安装包来源，建议直接跳过。</p>\n          <span class=\"addr\">下载地址：以订阅后收到的官方说明为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>电脑端</h3>\n          <p>桌面版和手机版登录同一个账号，设备数统一计算。装好之后先用一台设备登录试一下，确认正常再加第二台。</p>\n          <span class=\"addr\">下载地址：以订阅后收到的官方说明为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>其他设备</h3>\n          <p>如果你的设备不在上面两类里，先别急着装。把你的设备类型和系统版本记下来，问一下再决定，能少走弯路。</p>\n          <span class=\"addr\">下载地址：以订阅后收到的官方说明为准</span>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"faq\">\n      <h2>常见问题</h2>\n      <p class=\"sub\">下面是大家问得最多的几句，我按一问一答摆出来，你不用一条条去找。</p>\n      <div class=\"faq\">\n\n        <div class=\"qa\">\n          <div class=\"ask\">我到底该选哪一档？</div>\n          <div class=\"answer\">先数设备，再看流量。一个人一到三台设备、日常刷网页看看剧，基础版够；<strong>四五台设备、要玩游戏、希望工单被优先处理</strong>，选旗舰版；如果是几个人一起用或者办公场景，团队版更合适。拿不准就先月付试一个月。</div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"ask\">三台设备和五台设备，是同时在线还是总共能登录？</div>\n          <div class=\"answer\">说的是<strong>同时在线</strong>的设备数。如果你有四台设备但不会同时开，基础版其实也能应付；但如果你经常几台一起开着，就直接看旗舰版的 5 台。</div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"ask\">流量用超了会怎么样？</div>\n          <div class=\"answer\">每档套餐的每月流量额度写在上面了，用超之后的具体处理方式以你订阅时的说明为准。我的建议是：头一个月多留意用量，如果发现自己老是贴着上限，就在下个周期换一档，比每次临时处理要省心。</div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"ask\">月付和年付，哪个更适合我？</div>\n          <div class=\"answer\">年付价格相当于十个月的月付，<strong>确定会用满一年就年付</strong>；如果只是想先试试、或者不确定自己会不会一直用，月付更自由，换档也不用纠结。</div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"ask\">装了客户端连不上，第一步查什么？</div>\n          <div class=\"answer\">先确认三件事：账号是不是登录成功、当前设备数有没有超出套餐上限、以及是不是在客户端里选错了节点。这三样都对还不行，就带着你的设备类型和系统版本去提工单，说清楚现象，比反复重装有效得多。</div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"ask\">想从基础版换到旗舰版，会不会很麻烦？</div>\n          <div class=\"answer\">换档的具体规则以订阅时的说明为准，这部分不用猜。你可以先想清楚是流量不够还是设备数不够——如果只是设备数差一台，也许调整一下使用习惯就够了；如果两样都紧，那就直接升。</div>\n        </div>\n\n      </div>\n    </section>\n\n    <footer>\n      <span>光速 · 说明页</span>\n      <span>套餐价格与权益以本页所列内容为准</span>\n      <span>客户端下载地址以订阅后收到的说明为准</span>\n    </footer>\n  </main>\n\n</div>",
